---
import PageShell from '../layouts/page-shell.astro'
import ExperimentCard from '../components/experiments/experiment-card.astro'
import { experiments } from '../content/experiments'

const description = 'Small interface and interaction experiments by Craig Chihururu.'
---

<PageShell title="Experiments | Craig Chihururu" description={description} homeHref="/">
  <section class="mx-auto w-full max-w-[calc(var(--container-page)+var(--spacing-page-gutter)*2)] px-page-gutter pt-hero-top pb-section-y">
    <h1 class="sr-only">Experiments</h1>
    <div class="grid grid-cols-1 gap-x-md gap-y-3xl sm:grid-cols-2">
      {experiments.map((experiment) => <ExperimentCard experiment={experiment} />)}
    </div>
  </section>
</PageShell>
