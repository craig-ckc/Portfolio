---
/**
 * One article, at /writing/<slug>.
 *
 * Its own template, not the project page's. A project page opens on the work
 * — a full-bleed cover, then facts about the job — where an article opens on
 * what it is called: a centred header with the title, a subtitle, and
 * when it went up and how long it takes to read. Then the cover, held to the
 * page rather than bled off it, and then the reading.
 *
 * The body is the one thing it keeps in common with a project: the same
 * section shape from src/content/work.ts, heading, paragraphs and a single or
 * paired image.
 *
 * No way back and no next article, the same as a project page. The navbar is
 * the way home, and the end of a piece is allowed to be the end.
 */
import PageShell from '../../layouts/page-shell.astro'
import { Cta } from '../../components/sections/cta'
import { articles, formatPublished, type Article } from '../../content/writing'
import Frame from '../../components/writing/article-frame.astro'
import ArticleShare from '../../components/writing/article-share.astro'
import type { WorkMedia } from '../../content/work'
/* The load-in is `animate-article-rise`, staged in src/styles/tw/pages.css;
   article.css is left with nothing to import. */

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }))
}

interface Props {
  article: Article
}

const { article } = Astro.props
const shareUrl = new URL(`/writing/${article.slug}`, Astro.site).href

---

<PageShell
  title={`${article.title} | Craig Chihururu`}
  description={article.description}
  homeHref="/"
  article={{ published: article.published, topics: article.topics }}
>
  <article class="pt-hero-top pb-section-y">
    {/* Only what the piece is and when. Centred, because it is a title page
        and not the first paragraph: it is looked at, then left. */}
    <header
      class="mx-auto flex max-w-[calc(var(--container-content)+var(--spacing-2xl)*2)] flex-col items-center px-md text-center sm:px-2xl"
    >
      <h1
        class="font-display text-3xl font-semibold [font-variation-settings:'wght'_600] tracking-tight leading-tight sm:text-4xl motion-safe:animate-article-rise"
      >
        {article.title}
      </h1>
      <p
        class="mt-md max-w-[44ch] text-neutral-700 font-display text-lg tracking-snug leading-relaxed text-balance motion-safe:animate-article-rise motion-safe:[animation-delay:calc(var(--duration-fast)/3)]"
      >
        {article.description}
      </p>
      <p
        class="mt-xl flex gap-xs text-neutral-700 text-2xs leading-normal tabular-nums motion-safe:animate-article-rise motion-safe:[animation-delay:calc(var(--duration-fast)*2/3)]"
      >
        <time datetime={article.published}>{formatPublished(article.published)}</time>
        <span aria-hidden="true">·</span>
        <span>{article.readingMinutes} min read</span>
      </p>
    </header>

    {
      article.cover && (
        // Wider than the reading column: the cover is the one image looked at
        // before anything is read, so it is given more of the screen than a
        // paragraph has — the hero's own width.
        <figure
          class="mx-auto mt-4xl mb-0 max-w-[calc(var(--container-hero)+var(--spacing-2xl)*2)] px-md sm:px-2xl motion-safe:animate-article-rise motion-safe:[animation-delay:var(--duration-fast)]"
        >
          <Frame media={article.cover} eager cover />
        </figure>
      )
    }

    <div
      class="mx-auto max-w-[calc(var(--container-content)+var(--spacing-2xl)*2)] px-md pt-4xl sm:px-2xl motion-safe:animate-article-rise motion-safe:[animation-delay:var(--duration-fast)]"
    >
      {/* The way in. Set in the display face at a size between the subtitle
          and a heading, so the first thing read is a sentence and not a
          heading. */}
      <p class="text-foreground font-display text-lg tracking-snug leading-normal text-pretty sm:text-2xl">
        {article.summary}
      </p>

      {
        article.sections.map((section) => {
          const media = section.media ?? []
          /* A pair side by side on a phone is two thumbnails, so the grid
             drops to one column below the sm breakpoint; a single image
             keeps the wide 16:10 shape either way. */
          const paired = media.length > 1
          return (
            <section class="mt-4xl">
              <h2 class="mb-md font-display text-lg font-semibold [font-variation-settings:'wght'_600] tracking-snug leading-snug text-balance">
                {section.heading}
              </h2>

              <div class="flex flex-col gap-lg">
                {section.body.map((paragraph) => (
                  <p class="text-neutral-800 text-md tracking-normal leading-loose text-pretty">
                    {paragraph}
                  </p>
                ))}
              </div>

              {media.length > 0 && (
                <div class:list={['mt-2xl grid grid-cols-1 gap-sm', paired && 'sm:grid-cols-2']}>
                  {media.map((item: WorkMedia) => (
                    <figure class="m-0">
                      <Frame media={item} paired={paired} />
                      {item.caption && (
                        <figcaption class="mt-xs text-neutral-700 text-2xs leading-normal">
                          {item.caption}
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              )}
            </section>
          )
        })
      }

      <ArticleShare title={article.title} url={shareUrl} />
    </div>
  </article>

  <Cta />
</PageShell>
