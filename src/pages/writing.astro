---
/**
 * The writing list, at /writing.
 *
 * Every piece is a card within a card: its image is the whole card, and a
 * small pane of the homepage folder's frosted glass sits inside it carrying
 * the words. The featured piece leads, wide, with its title, subtitle and a
 * way in; every article, including the feature, follows in a grid. No
 * categories, no dates — those wait on the article's own page.
 */
import PageShell from "../layouts/page-shell.astro";
import { Cta } from "../components/sections/cta";
import WritingTile from "../components/writing/writing-tile.astro";
import { articles, writingPath } from "../content/writing";

const blurbLead =
  "Notes on design, on code, and on the bits in between that nobody writes down.";
/* The placeholder sentence is true only until the first article lands — once
   `articles` holds something, saying nothing is published would be wrong
   twice over: once about the page, and once about the entry sitting right
   underneath it. */
const blurb =
  articles.length > 0 ? blurbLead : `${blurbLead} Nothing published yet.`;

const sortedArticles = [...articles].sort((a, b) =>
  b.published.localeCompare(a.published),
);
const featured =
  sortedArticles.find((article) => article.featured) ?? sortedArticles[0];

/* The two sections' shared width: the work list's measure, plus the page
   gutter doubled back in since neither reaches the frame's own edge. */
const pageFrame = "w-full mx-auto px-page-gutter";
const wideMaxWidth =
  "max-w-[calc(var(--container-content-wide)+var(--spacing-page-gutter)*2)]";
---

<PageShell title="Writing | Craig Chihururu" description={blurb} homeHref="/">
  {
    featured ? (
      <section
        class:list={[
          pageFrame,
          /* The frosted-glass tint the tiles inside read from — was
             .writing__featured in writing.css, now declared where it cascades
             from instead of on a class of its own. */
          "[--writing-glass-top:rgb(255_255_255/18%)] [--writing-glass-bottom:rgb(255_255_255/8%)] [--writing-glass-edge:rgb(255_255_255/22%)]",
          wideMaxWidth,
          "py-hero-top",
        ]}
        aria-labelledby="writing-heading"
      >
        {/* The page still has a name for anyone navigating by headings; it is
            only the featured piece that is seen at the top. */}
        <h1 class="sr-only" id="writing-heading">
          Writing
        </h1>

        {/* One link around the whole card. The button inside it is the
            homepage hero's own, drawn as a span so it is not a second link to
            the same place. */}
        <WritingTile
          href={writingPath(featured.slug)}
          image={featured.card}
          title={featured.title}
          description={featured.description}
          featured
        />
      </section>
    ) : (
      <section class="w-full max-w-[calc(var(--container-page)+var(--spacing-page-gutter)*2)] mx-auto px-page-gutter flex flex-col items-start pt-hero-top pb-section-py">
        {/* Clears the fixed navbar the same way the placeholder pages' intro
            does — there is no hero and no cover above this one to do that
            job instead. */}
        <h1 class="font-display text-[clamp(2.5rem,4.8vw,5.75rem)] font-bold [font-variation-settings:'wght'_700] tracking-snug leading-tight">
          Writing
        </h1>
        <p class="mt-xl max-w-caption text-neutral-700 text-body leading-normal">
          {blurb}
        </p>
      </section>
    )
  }

  {
    sortedArticles.length > 0 && (
      <section
        class:list={[pageFrame, wideMaxWidth, "pb-section-y"]}
        aria-labelledby="all-writing-heading"
      >
        <h2 class="sr-only" id="all-writing-heading">
          All writing
        </h2>
        {/* Three across at the work list's width, two on a tablet, one on a
            phone. */}
        <div class="[--writing-glass-top:rgb(255_255_255/18%)] [--writing-glass-bottom:rgb(255_255_255/8%)] [--writing-glass-edge:rgb(255_255_255/22%)] grid grid-cols-1 gap-xl sm:grid-cols-2 md:grid-cols-3">
          {sortedArticles.map((article) => (
            <WritingTile
              href={writingPath(article.slug)}
              image={article.card}
              title={article.title}
            />
          ))}
        </div>
      </section>
    )
  }

  <Cta />
</PageShell>
