---
/**
 * The writing list, at /writing.
 *
 * The featured piece leads with a title, description and CTA; every article
 * follows in a grid. The featured card keeps an inset glass panel at the
 * bottom left; the grid uses the shared card's progressive blur overlay.
 */
import PageShell from "../layouts/page-shell.astro";
import { Cta } from "../components/sections/cta";
import WritingTile from "../components/writing/writing-tile.astro";
import { articles, writingPath } from "../content/writing";

const blurbLead =
  "Notes on design, on code, and on the bits in between that nobody writes down.";
/* The placeholder sentence is true only until the first article lands — once
   `articles` holds something, saying nothing is published would be wrong
   twice over: once about the page, and once about the entry sitting right
   underneath it. */
const blurb =
  articles.length > 0 ? blurbLead : `${blurbLead} Nothing published yet.`;

const sortedArticles = [...articles].sort((a, b) =>
  b.published.localeCompare(a.published),
);
const featured =
  sortedArticles.find((article) => article.featured) ?? sortedArticles[0];

/* The two sections share the work list's measure, plus the page gutter
   doubled back in since neither reaches the frame's own edge. Classes are
   written inline on each section rather than held in variables. */
---

<PageShell title="Writing | Craig Chihururu" description={blurb} homeHref="/">
  {
    featured ? (
      <section
        class:list={[
          "w-full mx-auto px-page-gutter",
          "max-w-content-wide-frame",
          "py-hero-top",
        ]}
        aria-labelledby="writing-heading"
      >
        {/* The page still has a name for anyone navigating by headings; it is
            only the featured piece that is seen at the top. */}
        <h1 class="sr-only" id="writing-heading">
          Writing
        </h1>

        {/* One link around the whole card. The button inside it is the
            homepage hero's own, drawn as a span so it is not a second link to
            the same place. */}
        <WritingTile
          href={writingPath(featured.slug)}
          image={featured.card}
          title={featured.title}
          description={featured.description}
          featured
        />
      </section>
    ) : (
      <section class="w-full max-w-page-frame mx-auto px-page-gutter flex flex-col items-start pt-hero-top pb-section-py">
        {/* Clears the fixed navbar the same way the placeholder pages' intro
            does — there is no hero and no cover above this one to do that
            job instead. */}
        <h1 class="font-display text-display-hero font-bold [font-variation-settings:'wght'_700] tracking-snug leading-tight">
          Writing
        </h1>
        <p class="mt-xl max-w-caption text-neutral-700 text-body leading-normal">
          {blurb}
        </p>
      </section>
    )
  }

  {
    sortedArticles.length > 0 && (
      <section
        class:list={[
          "w-full mx-auto px-page-gutter",
          "max-w-content-wide-frame",
          "pb-section-y",
        ]}
        aria-labelledby="all-writing-heading"
      >
        <h2 class="sr-only" id="all-writing-heading">
          All writing
        </h2>
        {/* Three across at the work list's width, two on a tablet, one on a
            phone. */}
        <div class="grid grid-cols-1 gap-xl sm:grid-cols-2 md:grid-cols-3">
          {sortedArticles.map((article) => (
            <WritingTile
              href={writingPath(article.slug)}
              image={article.card}
              title={article.title}
            />
          ))}
        </div>
      </section>
    )
  }

  <Cta />
</PageShell>
