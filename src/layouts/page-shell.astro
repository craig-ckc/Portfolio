---
// Chrome shared by every page in the site: the `.hp` wrapper, the navbar, the
// fixed footer. Lifted out of home-next.tsx and placeholder-page.tsx, which
// both hand-rolled the same shell.
import '../styles/home-page.css'
import Base from './base.astro'
import { NavBar } from '../components/layout/nav-bar'
import { Footer } from '../components/layout/footer'
import { THEME_STORAGE_KEY } from '../lib/theme'

interface Props {
  title?: string
  description?: string
  /** '#top' on the homepage; '/' anywhere else, where the anchor goes nowhere. */
  homeHref?: string
  /**
   * Homepage-only. The placeholder pages have no scroll-linked effects, and
   * the footer's `--reveal` reads from the shared frame loop in
   * src/lib/smooth-scroll.ts, which runs with or without Lenis — so there is
   * nothing for them to gain by paying for it.
   */
  smoothScroll?: boolean
}

const { title, description, homeHref = '#top', smoothScroll = false } = Astro.props
---

<Base title={title} description={description}>
  <div class="hp" data-theme="light">
    {/* Resolves the appearance before the first paint, which is why it is a
        blocking inline script rather than something the navbar island does:
        `client:load` hydration only runs after paint, so anyone who prefers
        dark would watch a white page flash first. Sitting inside `.hp` lets it
        write to its own parent while the rest of the wrapper is still being
        parsed.

        A stored choice wins; without one the operating system decides. The
        static `data-theme="light"` above stays as the answer for a visitor
        with no JavaScript at all. */}
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      const wrapper = document.currentScript.parentElement

      let stored = null
      try {
        stored = localStorage.getItem(storageKey)
      } catch {
        // Storage is locked down; the system preference is the fallback.
      }

      wrapper.dataset.theme =
        stored === 'light' || stored === 'dark'
          ? stored
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
    </script>
    <NavBar client:load homeHref={homeHref} />
    {/* Opaque and above the footer — the footer is fixed and revealed as this
        scrolls past it. */}
    <main class="content">
      <slot />
    </main>
    <Footer client:visible />
  </div>
</Base>

{
  smoothScroll && (
    <script>
      import { startSmoothScroll } from '../lib/smooth-scroll'
      startSmoothScroll()
    </script>
  )
}
