---
// Chrome shared by every page in the site: the `.hp` wrapper, the navbar, the
// fixed footer. Lifted out of home-next.tsx and placeholder-page.tsx, which
// both hand-rolled the same shell.
import Base from './base.astro'
import { BookingDialog } from '../components/booking/booking-dialog'
import { NavBar } from '../components/layout/nav-bar'
import { Footer } from '../components/layout/footer'
import ThemeResolver from '../components/layout/theme-resolver.astro'
import type { ArticleInfo } from '../lib/structured-data'

interface Props {
  title?: string
  description?: string
  /** '#top' on the homepage; '/' anywhere else, where the anchor goes nowhere. */
  homeHref?: string
  article?: ArticleInfo
}

const { title, description, homeHref = '#top', article } = Astro.props
---

<Base title={title} description={description} article={article}>
  {/* `hp` is the hook the dark tokens and the `dark:` variant key off
      (src/styles.css); everything it styles is on it as utilities.

      --footer-h is shared by the footer and the slot that reserves its scroll
      distance: 380px on a phone, 520px from the sm breakpoint up.

      --veil-fade / --veil-clear are how long the folder's veil takes to come
      up over the page and to go. Up here rather than with the folder because
      the navbar answers it too. Not the same either way, and the asymmetry is
      the point: coming up it is short (a third of the contents' flight — the
      page losing focus, not a thing arriving; a hard cut would flash), and
      going it has longer, because it is most of what says the scatter is
      being put away and it covers the cards' drop back under the flap. */}
  <div
    class="hp relative min-w-[320px] [--footer-h:380px] sm:[--footer-h:520px] [--veil-fade:var(--duration-fast)] [--veil-clear:var(--duration-base)] bg-background font-sans font-normal tracking-normal text-foreground [font-synthesis:none] antialiased"
    data-theme="light"
  >
    {/* Resolves the appearance before the first paint, which is why it is a
        blocking inline script rather than something the navbar island does:
        `client:load` hydration only runs after paint, so anyone who prefers
        dark would watch a white page flash first. Sitting inside `.hp` lets it
        write to its own parent while the rest of the wrapper is still being
        parsed.

        A stored choice wins; without one the operating system decides. The
        static `data-theme="light"` above stays as the answer for a visitor
        with no JavaScript at all. */}
    <ThemeResolver />
    <NavBar client:load homeHref={homeHref} />
    {/* Opaque and above the footer — the footer is fixed and revealed as this
        scrolls past it. */}
    <main class="relative z-[2] bg-background">
      <slot />
    </main>
    <Footer client:visible />

    {/* Inside `.hp` rather than beside it, even though showModal() lifts it
        into the top layer: the top layer changes what paints over what, not
        what inherits from what, so this is still where the dialog picks up the
        appearance the wrapper is carrying.

        `client:load` and not `client:idle`, because the thing it answers is the
        page's primary action and a click that lands before hydration leaves for
        cal.com instead. It costs almost nothing to have here: Cal's own script
        is not fetched until somebody opens it. */}
    <BookingDialog client:load />
  </div>
</Base>

{/* Smooth scrolling on every page, not per page: how the site scrolls is one
    interaction, and a reader moving from the homepage to an article should not
    feel the page change weight under them. startSmoothScroll leaves it off for
    anyone who prefers reduced motion. */}
<script>
  import { startSmoothScroll } from '../lib/smooth-scroll'
  startSmoothScroll()
</script>
