---
// Document shell, replacing index.html's static <head> plus the CSS imports
// that used to live in src/main.tsx. Astro supports CSS imports straight from
// frontmatter, so all of it collapses into one file.
import '@fontsource/manrope/latin-400.css'
import '@fontsource/manrope/latin-500.css'
import '@fontsource/manrope/latin-600.css'
import '@fontsource/manrope/latin-700.css'
// Lenis asserts `scroll-behavior: auto` itself; this used to be imported from
// inside src/lib/smooth-scroll.ts, but that module now runs client-side only
// (via a page-level <script>) and no longer executes at import time under
// SSR, so the stylesheet has to be pulled in up here instead.
import 'lenis/dist/lenis.css'
import '../styles.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Craig Chihururu — Designer + Developer',
  description = 'Craig Chihururu is a designer and developer helping brands build thoughtful websites and digital products.',
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Two hand-tuned SVGs per appearance rather than one scaling file: the 16
        and 32 artboards have their own paths so the glyph stays crisp at tab
        size. The pairing is the browser's appearance, not the site's own
        `data-theme` toggle — a favicon sits in the tab strip, so it has to read
        against the browser chrome, which the toggle does not change. */}
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="32x32"
      media="(prefers-color-scheme: light)"
      href="/img/favicon-light-32x32.svg"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="16x16"
      media="(prefers-color-scheme: light)"
      href="/img/favicon-light-16x16.svg"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="32x32"
      media="(prefers-color-scheme: dark)"
      href="/img/favicon-dark-32x32.svg"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="16x16"
      media="(prefers-color-scheme: dark)"
      href="/img/favicon-dark-16x16.svg"
    />
    <meta name="author" content="Craig Chihururu" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d4fff" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
