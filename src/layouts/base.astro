---
// Document shell, replacing index.html's static <head> plus the CSS imports
// that used to live in src/main.tsx. Astro supports CSS imports straight from
// frontmatter, so all of it collapses into one file.
import '@fontsource/manrope/latin-400.css'
import '@fontsource/manrope/latin-500.css'
import '@fontsource/manrope/latin-600.css'
import '@fontsource/manrope/latin-700.css'
// Lenis asserts `scroll-behavior: auto` itself; this used to be imported from
// inside src/lib/smooth-scroll.ts, but that module now runs client-side only
// (via a page-level <script>) and no longer executes at import time under
// SSR, so the stylesheet has to be pulled in up here instead.
import 'lenis/dist/lenis.css'
import '../styles.css'
import { canonicalUrl, requireSite } from '../lib/sitemap'
import { SHARE_IMAGE } from '../lib/share-image'
import { serializeJsonLd, structuredData, type ArticleInfo } from '../lib/structured-data'

interface Props {
  title?: string
  description?: string
  article?: ArticleInfo
}

const {
  title = 'Craig Chihururu | Designer + Developer',
  description = 'Craig Chihururu is a designer and developer helping brands build thoughtful websites and digital products.',
  article,
} = Astro.props

/* Absolute URLs, built from the one origin in astro.config.mjs. A crawler or
   a scraper has no page to resolve a relative path against and drops the tag
   rather than guess, so rel=canonical, og:url and the JSON-LD all need them
   spelled out in full.

   `canonical` comes from Astro.url.pathname, which carries no query string —
   so ?ref=… and ?utm_source=… arrive at a page that names the clean URL as
   the real one instead of splitting its ranking signals across every variant. */
const site = requireSite(Astro.site)
const canonical = canonicalUrl(site, Astro.url.pathname)
const shareImage = new URL(SHARE_IMAGE.src, site).href

/* Structured data, built from the same canonical URL, title and description
   the og: tags use, so the two descriptions of the page agree. */
const jsonLd = serializeJsonLd(structuredData(site, { url: canonical, title, description }, article))
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Two hand-tuned SVGs per appearance rather than one scaling file: the 16
        and 32 artboards have their own paths so the glyph stays crisp at tab
        size. The pairing is the browser's appearance, not the site's own
        `data-theme` toggle — a favicon sits in the tab strip, so it has to read
        against the browser chrome, which the toggle does not change. */}
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="32x32"
      media="(prefers-color-scheme: light)"
      href="/img/favicon-light-32x32.svg"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="16x16"
      media="(prefers-color-scheme: light)"
      href="/img/favicon-light-16x16.svg"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="32x32"
      media="(prefers-color-scheme: dark)"
      href="/img/favicon-dark-32x32.svg"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="16x16"
      media="(prefers-color-scheme: dark)"
      href="/img/favicon-dark-16x16.svg"
    />
    <meta name="author" content="Craig Chihururu" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d4fff" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {/* The page's own preferred URL. The site answers on three hosts and both
        with and without a trailing slash; this is what says which of those
        spellings the ranking signals belong to. Exactly one per page — it
        lives here rather than in any page so there is nowhere for a second to
        come from. */}
    <link rel="canonical" href={canonical} />
    {/* Open Graph, so a shared link renders as a card rather than a bare URL.
        og:title and og:description track <title> and the meta description
        above: one page, one claim about what it is.

        og:url is the load-bearing one here. The site answers on three hosts —
        the apex and the .vercel.app both 308 to www — and without it a share
        of the same page from two of them counts as two pages. */}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Craig Chihururu" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    {/* Declaring the size lets a scraper lay the card out before it has
        finished fetching the image, which is what stops the first share of a
        cold URL rendering small. */}
    <meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
    <meta property="og:image:alt" content={SHARE_IMAGE.alt} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article?.topics.map((topic) => <meta property="article:tag" content={topic} />)}
    {/* X reads the og: tags for everything else, but it will only render the
        wide card if this says so — the default is a small square thumbnail. */}
    <meta name="twitter:card" content="summary_large_image" />
    {/* JSON-LD: a Person for Craig, a WebSite for the site, and a WebPage for
        this page, joined by @id. `is:inline` for the same reason as the tags
        below — it has to reach the document as written, and there is nothing
        here for Astro to bundle. `set:html` because the value is already
        serialised JSON, which Astro would otherwise HTML-escape into garbage. */}
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    {/* Google Analytics (gtag.js). `is:inline` keeps both tags in the head as
        written — Astro would otherwise hoist and bundle them, which delays the
        measurement snippet past the point where it can see the first page
        view. */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-5L0JXWGY7V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())

      gtag('config', 'G-5L0JXWGY7V')
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
