---
/**
 * One image on a project page, drawn in the frame the whole page uses.
 *
 * `src` is allowed to be missing. None of the work records carry imagery yet,
 * and a flat --neutral-600 fill in the right shape is a truer placeholder than
 * a broken image or a slot that collapses to nothing — it is the same fill the
 * homepage tiles fall back to, so an unfinished project page and an unfinished
 * homepage row look unfinished in the same way.
 *
 * Every section image uses the same 16/10 frame, whether it fills a row or
 * shares one. The cover fills its hero container instead.
 */
import type { WorkMedia } from '../../content/work'

interface Props {
  media: WorkMedia
  /**
   * The frame takes the height of its container instead of holding a shape of
   * its own, and drops the border and radius it wears in the body. The cover
   * only: it is the whole hero rather than a box on the page.
   */
  fill?: boolean
  /**
   * The cover is the one image above the fold and the page's largest asset, so
   * it is the one image not deferred. Everything else waits until the reader is
   * on their way to it.
   */
  loading?: 'eager' | 'lazy'
  label?: string
  /** The hero remains a static image; only section images join the gallery. */
  lightbox?: boolean
}

const { media, fill = false, loading = 'lazy', label = 'Project image', lightbox = true } = Astro.props
const Frame = lightbox ? 'button' : 'div'
---

<figure class:list={['flex min-w-0 flex-col m-0 gap-xs', fill && 'h-full']}>
  <Frame
    type={lightbox ? 'button' : undefined}
    data-project-image={lightbox || undefined}
    data-image-label={lightbox ? media.caption || media.alt || label : undefined}
    aria-label={lightbox ? `Open ${media.caption || media.alt || label} in gallery` : undefined}
    aria-haspopup={lightbox ? 'dialog' : undefined}
    class:list={[
      'relative block w-full p-0 overflow-hidden border rounded-lg bg-neutral-600',
      lightbox && 'project-image-trigger cursor-zoom-in',
      fill ? 'h-full aspect-auto border-0 rounded-none' : 'aspect-16/10',
      !fill && 'border-(--project-box-rule)',
    ]}
  >
    {
      media.src && (
        <img
          class="h-full w-full object-cover"
          src={media.src}
          alt={media.alt ?? ''}
          loading={loading}
          decoding="async"
        />
      )
    }
  </Frame>
  {media.caption && <figcaption class="mt-xs text-neutral-700 text-2xs leading-normal">{media.caption}</figcaption>}
</figure>
