---
interface Props {
  title: string
}

const { title } = Astro.props
---

<dialog class="project-gallery" aria-label={`${title} image gallery`} data-project-gallery data-lenis-prevent>
  <header class="project-gallery__toolbar" data-gallery-chrome>
    <span class="project-gallery__title">{title}</span>
    <button type="button" class="icon-button" data-gallery-close aria-label="Close gallery" autofocus>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m6 6 12 12M6 18 18 6" />
      </svg>
    </button>
  </header>

  <div class="project-gallery__track" data-gallery-track tabindex="0" role="region" aria-label="Project images. Drag, swipe, or use the arrow keys to explore." />

  <footer class="project-gallery__footer" data-gallery-chrome>
    <div class="project-gallery__navigation">
      <span class="project-gallery__counter" aria-live="polite" aria-atomic="true" data-gallery-counter></span>
      <button type="button" class="icon-button" data-gallery-prev aria-label="Previous image">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="m14 6-6 6 6 6" />
        </svg>
      </button>
      <button type="button" class="icon-button" data-gallery-next aria-label="Next image">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="m10 6 6 6-6 6" />
        </svg>
      </button>
    </div>
  </footer>
</dialog>

<script>
  import { setupProjectGallery } from '../../lib/project-gallery'
  const source = document.querySelector<HTMLElement>('[data-project-gallery-source]')
  const dialog = document.querySelector<HTMLDialogElement>('[data-project-gallery]')
  if (source && dialog) setupProjectGallery(source, dialog)
</script>
