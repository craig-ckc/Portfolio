---
import { LinkedInLogo, XLogo } from '../icons'

interface Props {
  title: string
  url: string
}

const { title, url } = Astro.props
const xShare = new URL('https://twitter.com/intent/tweet')
xShare.searchParams.set('text', title)
xShare.searchParams.set('url', url)

const linkedInShare = new URL('https://www.linkedin.com/sharing/share-offsite/')
linkedInShare.searchParams.set('url', url)
---

<section
  class="mt-4xl flex flex-wrap items-center justify-center gap-lg border-t border-neutral-600 pt-xl"
  aria-labelledby="article-share-heading"
>
  <h2
    class="font-display text-base font-medium [font-variation-settings:'wght'_500] tracking-snug leading-normal"
    id="article-share-heading"
  >
    Share this article
  </h2>

  <div class="social">
    <a href={xShare.href} target="_blank" rel="noreferrer" aria-label="Share this article on X">
      <XLogo />
    </a>

    <a
      href={linkedInShare.href}
      target="_blank"
      rel="noreferrer"
      aria-label="Share this article on LinkedIn"
    >
      <LinkedInLogo />
    </a>

    <button class="icon-button" type="button" aria-label="Copy link" title="Copy link" data-copy-link data-url={url}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-copy-icon>
        <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      <svg class="hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-copied-icon>
        <path d="m5 12 4 4L19 6" />
      </svg>
    </button>
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]')
  const copyIcon = copyButton?.querySelector<SVGSVGElement>('[data-copy-icon]')
  const copiedIcon = copyButton?.querySelector<SVGSVGElement>('[data-copied-icon]')
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]')
  let resetTimer: number | undefined

  copyButton?.addEventListener('click', async () => {
    const url = copyButton.dataset.url
    if (!url || !copyIcon || !copiedIcon || !copyStatus) return

    window.clearTimeout(resetTimer)
    const setFeedback = (label: string, copied = false) => {
      copyButton.ariaLabel = label
      copyButton.title = label
      copyIcon.classList.toggle('hidden', copied)
      copiedIcon.classList.toggle('hidden', !copied)
    }

    try {
      if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable')
      await navigator.clipboard.writeText(url)

      setFeedback('Link copied', true)
      copyStatus.textContent = 'Article link copied to the clipboard.'
    } catch {
      setFeedback('Copy failed')
      copyStatus.textContent = 'The article link could not be copied. Copy it from the address bar instead.'
    }

    resetTimer = window.setTimeout(() => {
      setFeedback('Copy link')
    }, 2400)
  })
</script>
