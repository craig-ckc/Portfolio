---
import ContentCard from '../content-card.astro'
import type { WorkMedia } from '../../content/work'

interface Props {
  href: string
  image: WorkMedia
  title: string
  /** Only read for the featured tile: every other pane keeps to a title. */
  description?: string
  /** The lead card keeps its inset panel and includes a description and CTA. */
  featured?: boolean
}

const { href, image, title, description, featured = false } = Astro.props
---

<ContentCard
  href={href}
  variant={featured ? 'inset' : 'overlay'}
  class={featured ? 'min-h-160' : undefined}
>
  {image.src && (
    <img
      slot="media"
      class="h-full w-full object-cover"
      src={image.src}
      alt={image.alt ?? ''}
      loading={featured ? undefined : 'lazy'}
      decoding="async"
    />
  )}

  <div class="flex max-w-caption flex-col items-start">
    {
      featured ? (
        <h2 class="font-display text-2xl font-semibold [font-variation-settings:'wght'_600] tracking-snug leading-tight text-balance sm:text-3xl">
          {title}
        </h2>
      ) : (
        <h3 class="font-display text-md font-semibold [font-variation-settings:'wght'_600] tracking-snug leading-snug text-balance">
          {title}
        </h3>
      )
    }

    {
      featured && description && (
        <p class="mt-md text-white/78 font-display text-base tracking-snug leading-relaxed text-pretty">
          {description}
        </p>
      )
    }

    {featured && <span class="chip chip-cta mt-xl">Read article</span>}
  </div>
</ContentCard>
