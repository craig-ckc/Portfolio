---
/**
 * One tile in the writing list: an image is the whole card, and a pane of
 * the homepage folder's frosted glass sits over it carrying the words. The
 * featured piece leads wide, its pane top-left holding the title, the
 * subtitle and a way in; every other tile — including the feature, again,
 * once it repeats in the grid below — carries only its title, pane pinned to
 * the bottom edge.
 *
 * The glass itself: the homepage folder's frost — the same blur and
 * saturation as .folder__frost in home-page.css — with a light tint rather
 * than the folder's near-opaque one. The folder's front sits on the page, so
 * its tint follows the page; this pane sits on a photograph in either
 * appearance, so it stays the same in both — clear enough for the picture to
 * show through, white type on it. Opaque, it would read as a black box
 * pasted on the image rather than glass over it. --writing-glass-* are
 * declared as arbitrary-property utilities on the sections that hold these
 * tiles, in src/pages/writing.astro.
 */
import type { WorkMedia } from '../../content/work'

interface Props {
  href: string
  image: WorkMedia
  title: string
  /** Only read for the featured tile: every other pane keeps to a title. */
  description?: string
  /**
   * The lead card: wide, its image the homepage hero's own height, its pane
   * set top-left and holding more than a title. Every other tile is the
   * homepage work row's height, title-only, pane pinned to the bottom edge.
   */
  featured?: boolean
}

const { href, image, title, description, featured = false } = Astro.props

/* Held on its own compositor layer from the start, not only while it moves.
   Without this the browser lifts the image onto a GPU layer for the length of
   the zoom and hands it back to ordinary painting the moment the transition
   ends — and the hand-back re-snaps it to whole pixels, which is the small
   jump seen as the zoom settles. With the layer kept, nothing changes hands at
   the end, so there is nothing to jump. */
const imageClasses =
  "h-full w-full object-cover transition-transform duration-760 ease-out-quart group-hover:scale-[1.03] [will-change:transform]"
---

<a class="group relative isolate block overflow-hidden rounded-lg" href={href}>
  <div
    class:list={[
      'w-full bg-neutral-600',
      /* The homepage work tile's height, half the featured card's — a height
         of its own rather than 100%, because the tile has none until its
         image gives it one. */
      featured ? 'h-[640px]' : 'h-[320px]',
    ]}
  >
    {
      image.src && (
        <img
          class={imageClasses}
          src={image.src}
          alt={image.alt ?? ''}
          loading={featured ? undefined : 'lazy'}
        />
      )
    }
  </div>

  {/* The inner card, set in from the outer card's edge by its own padding and
      rounded one step tighter, so the two corners sit concentric. Pinned to
      the bottom edge everywhere except the featured tile from the tablet
      breakpoint up, where it moves top-left and widens to the caption
      measure so its lines stay short. */}
  <div
    class:list={[
      'absolute right-sm bottom-sm left-sm flex flex-col items-start rounded-md border border-(--writing-glass-edge) p-lg text-white [background-image:linear-gradient(180deg,var(--writing-glass-top),var(--writing-glass-bottom))] [backdrop-filter:blur(26px)_saturate(140%)]',
      featured &&
        'sm:top-2xl sm:right-auto sm:bottom-auto sm:left-2xl sm:max-w-caption sm:p-2xl',
    ]}
  >
    {
      featured ? (
        <h2 class="font-display text-2xl font-semibold [font-variation-settings:'wght'_600] tracking-snug leading-tight text-balance sm:text-3xl">
          {title}
        </h2>
      ) : (
        <h3 class="font-display text-md font-semibold [font-variation-settings:'wght'_600] tracking-snug leading-snug text-balance">
          {title}
        </h3>
      )
    }

    {
      featured && description && (
        <p class="mt-md text-white/78 font-display text-base tracking-snug leading-relaxed text-pretty">
          {description}
        </p>
      )
    }

    {featured && <span class="chip chip-cta mt-xl">Read article</span>}
  </div>
</a>
