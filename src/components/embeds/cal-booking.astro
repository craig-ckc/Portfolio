---
// Cal.com's element-click embed. There is no component to render and nothing
// to wire up per CTA: the embed listens on the document, and any element
// carrying `data-cal-link` opens the booking modal. Spread `bookingTrigger`
// from src/content/home-page.ts onto whichever element should do that.
//
// Rendered once from page-shell, since the closing CTA section sits on every
// page.
import { booking } from '../../content/home-page'
---

{/* `is:inline` because this has to stay one script that defines a global and
    queues against it — Astro would otherwise bundle it as a deferred module.
    The loader itself is Cal's, pasted as they ship it: reformatting minified
    vendor code buys nothing and makes the next paste harder to diff. */}
<script is:inline define:vars={{ namespace: booking.namespace, origin: booking.origin }}>
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", namespace, { origin: origin })
  Cal.config = Cal.config || {}
  Cal.config.forwardQueryParams = true
  Cal.ns[namespace]("ui", { hideEventTypeDetails: false, layout: "month_view" })

  /* Cal's click handler opens the modal but never cancels the click, so the
     trigger's href would navigate away underneath it. Cancelling here leaves
     that href doing the one job it is there for: taking a visitor with no
     JavaScript to the same booking page. */
  document.addEventListener('click', (event) => {
    const target = event.target
    if (target instanceof Element && target.closest('a[data-cal-link]')) {
      event.preventDefault()
    }
  })
</script>
