---
import type { Experiment } from '../../content/experiments'
import { experimentPath } from '../../content/experiments'
import ExperimentPreview from './experiment-preview.astro'
import ContentCard from '../content-card.astro'

interface Props {
  experiment: Experiment
}

const { experiment } = Astro.props
---

<ContentCard href={experimentPath(experiment.slug)} aria-labelledby={`experiment-${experiment.slug}`} data-experiment-card>
  <ExperimentPreview slot="media" experiment={experiment} />
  <h2 id={`experiment-${experiment.slug}`} class="font-display text-md font-semibold [font-variation-settings:'wght'_600] tracking-snug leading-snug text-balance">
    {experiment.title}
  </h2>
</ContentCard>

<script>
  import { setupExperimentPreview } from '../../lib/experiment-preview-controller'
  document.querySelectorAll<HTMLAnchorElement>('[data-experiment-card]').forEach(setupExperimentPreview)
</script>
