---
import type { ExperimentKind } from '../../content/experiments'

interface Props {
  kind: ExperimentKind
}

const { kind } = Astro.props

const dockIcons = [
  '/img/dock/figma.svg',
  '/img/dock/vscode.webp',
  '/img/dock/codex.webp',
  '/img/dock/claude.webp',
  '/img/dock/paper.webp',
]
---

{
  kind === 'dock' ? (
    <div class="flex h-full items-center justify-center bg-neutral-300 dark:bg-neutral-900">
      <div class="flex w-[72%] items-end justify-center gap-[3%] rounded-[clamp(14px,2vw,30px)] border border-white/60 bg-white/60 px-[5%] pt-[4%] pb-[3%] shadow-[0_18px_50px_rgb(21_21_21/12%)] [backdrop-filter:blur(20px)_saturate(140%)]">
        {dockIcons.map((icon, index) => (
          <img
            class:list={[
              'block min-w-0 flex-1 origin-bottom transition-transform duration-320 ease-out-cubic',
              index === 2 ? 'group-hover:-translate-y-[14%] group-hover:scale-[1.34]' : '',
              index === 1 || index === 3 ? 'group-hover:-translate-y-[5%] group-hover:scale-[1.12]' : '',
            ]}
            src={icon}
            alt=""
            loading="lazy"
          />
        ))}
      </div>
    </div>
  ) : (
    <div class="relative h-full overflow-hidden bg-[#ece8df] dark:bg-neutral-900">
      <div class="absolute top-1/2 left-1/2 aspect-square w-[42%] -translate-x-[30%] -translate-y-1/2 rounded-full bg-[#111] shadow-[0_22px_55px_rgb(21_21_21/22%)] transition-transform duration-560 ease-out-cubic group-hover:translate-x-[2%] group-hover:rotate-45">
        <div class="absolute inset-[34%] overflow-hidden rounded-full">
          <img class="h-full w-full object-cover" src="/img/music/happy-tears.jpg" alt="" loading="lazy" />
        </div>
        <span class="absolute top-1/2 left-1/2 size-[4%] -translate-1/2 rounded-full bg-[#f9f9f9]"></span>
      </div>
      <div class="absolute top-1/2 left-1/2 aspect-square w-[42%] -translate-x-[70%] -translate-y-1/2 overflow-hidden rounded-md shadow-[0_24px_60px_rgb(21_21_21/18%)]">
        <img class="h-full w-full object-cover" src="/img/music/happy-tears.jpg" alt="" loading="lazy" />
      </div>
    </div>
  )
}
