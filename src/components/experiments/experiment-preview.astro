---
import type { Experiment } from '../../content/experiments'
import { projectPreviews } from '../../content/project-previews'

interface Props {
  experiment: Experiment
}

const { experiment } = Astro.props
const columns = [
  { projects: [3, 0, 2], className: '-translate-y-[8%] scale-90 opacity-80 blur-[1px]' },
  { projects: [2, 1, 0], className: 'scale-110' },
  { projects: [0, 3, 1], className: 'translate-y-[8%] scale-90 opacity-80 blur-[1px]' },
]
---

{experiment.slug === 'infinite-field' ? (
  <div class="relative h-full overflow-hidden bg-background" aria-hidden="true">
    <div class="absolute inset-0 overflow-hidden [mask-image:radial-gradient(circle_closest-side,#000_35%,transparent_100%)]">
      <div class="absolute -inset-y-[20%] inset-x-[5%] grid grid-cols-3 items-center gap-[8%]">
        {columns.map((column) => (
          <div class:list={['flex flex-col gap-5', column.className]}>
            {column.projects.map((index) => {
              const image = projectPreviews[index]
              return <img class="block h-auto w-full rounded" src={image.src} width={image.width} height={image.height} alt="" loading="lazy" />
            })}
          </div>
        ))}
      </div>
    </div>
  </div>
) : (
  <div class="h-full bg-neutral-300" aria-hidden="true"></div>
)}
